      "streaming": "form[data-chatgpt-composer] button[aria-label=\"Stop\"], button[data-testid=\"stop-button\"], button[aria-label*=\"Stop\" i], [data-talvt-turn-state]:not([data-talvt-turn-state=\"complete\"])",
